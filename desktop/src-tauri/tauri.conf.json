{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcendent Switch",
  "version": "0.1.0",
  "identifier": "app.transcendent.switch",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Transcendent Switch",
        "width": 320,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
