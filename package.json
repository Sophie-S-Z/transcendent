{
  "name": "transcendent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public/mediapipe',{recursive:true});for(const f of ['vision_wasm_internal.js','vision_wasm_internal.wasm'])fs.copyFileSync('node_modules/@mediapipe/tasks-vision/wasm/'+f,'public/mediapipe/'+f)\"",
    "simulate": "node scripts/simulate.mjs",
    "build:extension": "vite build --config extension/vite.config.ts",
    "build:desktop": "vite build --config desktop/vite.config.ts",
    "test:extension": "npm run build:extension && node extension/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@mlc-ai/web-llm": "^0.2.89",
    "@paper-design/shaders-react": "^0.0.82",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
